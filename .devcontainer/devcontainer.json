{
	// Identity.
	"name": "scihfs-dev",
	// Image or build.
	// "image": "jpsachs/scihfs-devcontainer:latest",
	"image": "scihfs-dev-local:latest",
	// Mount and workspace configuration.
	"workspaceMount": "source=${localWorkspaceFolder},target=/scihfs,type=bind",
	"workspaceFolder": "/scihfs",
	// Runtime configuration.
	"runArgs": [
		"--rm"
	],
	"shutdownAction": "stopContainer",
	"remoteUser": "nonroot",
	// Lifecycle hooks.
	"postCreateCommand": "uv sync --frozen && uv run pre-commit install && git config --global user.signingKey ''",
	// Customizations.
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.profiles.linux": {
					"zsh": {
						"path": "/bin/zsh"
					}
				},
				"terminal.integrated.defaultProfile.linux": "zsh",
				"python.defaultInterpreterPath": "/scihfs/.venv/bin/python"
			},
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.flake8",
				"ms-python.black-formatter",
				"ms-python.isort"
			]
		}
	}
}
