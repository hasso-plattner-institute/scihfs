# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Sphinx documentation
doc/_build/
doc/auto_examples/
doc/modules/generated/
doc/datasets/generated/
doc/generated/
doc/doctrees/
doc/sg_execution_times.rst

# Distribution / packaging
.Python
env/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log

# PyBuilder
target/

# Data
scihfs/data/*
!scihfs/data/**.py
!scihfs/data/**_testing**

# Results
results/

# Slurm output files
slurm-*.out

# WandB
wandb

# Specific VS Code configuration files
.vscode/*

# Other Python-related files
.pytest_cache

# File generated by deckar01-ratelimit (subdependency of kgextension)
rate_limits.db

# Exclude OS-specific files
.DS_Store
